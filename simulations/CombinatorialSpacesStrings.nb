Cell[BoxData[
 RowBox[{
  RowBox[{"outputPlots2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dataList", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "simDir", ",", "assemblyData", ",", "dataList", ",", 
           "dataListSorted", ",", "minmaxAssemblyIndex"}], "}"}], ",", 
         RowBox[{
          RowBox[{"simDir", "=", 
           RowBox[{
           "baseDirectory", "<>", "\"\<PeptideSimData/\>\"", 
            "<>", "\"\<SelectiveFac_\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"selectiveFactorList", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"assemblyData", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"fileData", "=", 
               RowBox[{"Partition", "[", 
                RowBox[{
                 RowBox[{"StringSplit", "[", 
                  RowBox[{
                   RowBox[{"Import", "[", 
                    RowBox[{"simDir", "<>", "\"\</string_data_\>\"", "<>", 
                    RowBox[{"ToString", "[", "runID", "]"}], 
                    "<>", "\"\</seqList_\>\"", "<>", 
                    RowBox[{"ToString", "[", "runID", "]"}], 
                    "<>", "\"\<.txtOut\>\""}], "]"}], ",", "\"\<\\n\>\""}], 
                  "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dataList", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"First", "@", 
                    RowBox[{"StringSplit", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fileData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< \>\""}], 
                    "]"}]}], ",", 
                   RowBox[{"ToExpression", "@", 
                    RowBox[{"Last", "@", 
                    RowBox[{"StringSplit", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fileData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< \>\""}], 
                    "]"}]}]}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", 
                   RowBox[{"Length", "@", "fileData"}]}], "}"}]}], "]"}]}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"dataListSorted", "=", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"maxAssemblyIndex", "=", 
               RowBox[{"Max", "@", 
                RowBox[{
                 RowBox[{"dataList", "[", 
                  RowBox[{"[", "runID", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{
                 RowBox[{"dataList", "[", 
                  RowBox[{"[", "runID", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "==", "ai"}], "&"}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"ai", ",", "0", ",", "maxAssemblyIndex"}], "}"}]}], 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}], ",", "runID"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"minmaxAssemblyIndex", "=", 
       RowBox[{"Min", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"First", "@", 
             RowBox[{"Last", "@", 
              RowBox[{"dataListSorted", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "@", "dataListSorted"}]}], "}"}]}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"plot", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"pairData", ",", "simList"}], "}"}], ",", 
             RowBox[{
              RowBox[{"pairData", "=", 
               RowBox[{"Subsets", "[", 
                RowBox[{
                 RowBox[{"Block", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"data", "=", 
                    RowBox[{"dataListSorted", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "&"}], "/@", 
                    RowBox[{"Range", "[", "nRuns", "]"}]}]}], "]"}], ",", 
                 RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"simList", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"N", "@", 
                  FractionBox[
                   RowBox[{"Length", "@", 
                    RowBox[{"(", 
                    RowBox[{"Intersection", "@@", 
                    RowBox[{"pairData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], 
                   RowBox[{"Length", "@", 
                    RowBox[{"(", 
                    RowBox[{"Union", "@@", 
                    RowBox[{"pairData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", 
                   RowBox[{"Length", "@", "pairData"}]}], "}"}]}], "]"}]}], ";", 
              RowBox[{"Around", "[", 
               RowBox[{
                RowBox[{"Mean", "@", "simList"}], ",", 
                RowBox[{"StandardDeviation", "@", "simList"}]}], "]"}]}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "minmaxAssemblyIndex"}], "}"}]}], "]"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"\"\<Selective Factor: \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"selectiveFactorList", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Assembly Index\>\"", ",", "\"\<Similarity\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}], ",", 
         RowBox[{"Filling", "->", "Axis"}], ",", 
         RowBox[{"LabelStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"FontColor", "\[Rule]", "Black"}], ",", 
              RowBox[{"FontSize", "\[Rule]", "18"}]}], "]"}]}], "}"}]}], ",", 
         
         RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "baseDirectory", "<>", "\"\<PeptideSimData/\>\"", 
         "<>", "\"\</Distribution_SF_\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"selectiveFactorList", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], 
         "<>", "\"\<_SimilarityPlot.png\>\""}], ",", "plot", ",", 
        RowBox[{"ImageResolution", "->", "300"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "baseDirectory", "<>", "\"\<PeptideSimData/\>\"", 
         "<>", "\"\</Distribution_SF_\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"selectiveFactorList", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], 
         "<>", "\"\<_SimilarityPlot.svg\>\""}], ",", "plot"}], "]"}], ";", 
      "plot"}], ",", 
