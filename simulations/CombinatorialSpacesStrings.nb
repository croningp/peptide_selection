Cell["\<\
Here, we generate assembly possible by random combination (undirected) of \
objects within a physical space. We investigate the expansion of assembly \
space with different number of initial objects and comparing the shared \
spaces different exploration runs. \
\>", "Text",
 CellChangeTimes->{{3.945067349790187*^9, 3.9450674188863983`*^9}, {
  3.945233666349814*^9, 3.945233681118147*^9}, {3.945233946595277*^9, 
  3.945233947608646*^9}},ExpressionUUID->"0247cdee-8018-46ca-bf5a-\
ad43769c7019"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateAssemblyPossible", "[", 
   RowBox[{"nInitObjects_", ",", "nSteps_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"initObjects", ",", "obj1", ",", "obj2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"assemblyPool", ",", "assemblyStep"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"initObjects", "=", 
      RowBox[{
       RowBox[{"Alphabet", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "nInitObjects"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assemblyPool", "=", "initObjects"}], ";", 
     RowBox[{"assemblyStep", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"obj1", "=", 
           RowBox[{"RandomChoice", "[", "assemblyPool", "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Selecting", " ", "first", " ", "object", " ", "randomly"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"obj2", "=", 
           RowBox[{"RandomChoice", "[", "assemblyPool", "]"}]}], ";", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Selecting", " ", "second", " ", "object", " ", "randomly"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"assemblyStep", "=", 
           RowBox[{"Union", "@", 
            RowBox[{"Append", "[", 
             RowBox[{"assemblyStep", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"obj1", "->", 
                 RowBox[{"obj1", "<>", "obj2"}]}], ",", 
                RowBox[{"obj2", "->", 
                 RowBox[{"obj1", "<>", "obj2"}]}]}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"assemblyPool", "=", 
           RowBox[{"Union", "@", 
            RowBox[{"Append", "[", 
             RowBox[{"assemblyPool", ",", 
              RowBox[{"obj1", "<>", "obj2"}]}], "]"}]}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nSteps"}], "}"}]}], "]"}], ",", "i"}], 
      "]"}], ";", " ", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"assemblyStep", ",", "assemblyPool"}], "}"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.945233589722644*^9, 3.945233617716036*^9}, {
  3.945255203916061*^9, 3.945255213874106*^9}, {3.945264324639765*^9, 
  3.945264328077571*^9}, {3.9452643865384493`*^9, 3.945264423132271*^9}, {
