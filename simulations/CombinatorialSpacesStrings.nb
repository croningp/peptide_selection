Cell[BoxData[
 RowBox[{
  RowBox[{"outputPlots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "simDir", ",", "fileData", ",", "assemblyData", ",", "allData", ",", 
         "pts", ",", "maxLength", ",", "binCounts", ",", "maxCount", ",", 
         "logMax", ",", "majorCounts", ",", "legendTicks", ",", 
         "colourFunction", ",", "legend", ",", "plot"}], "}"}], ",", 
       RowBox[{
        RowBox[{"simDir", "=", 
         RowBox[{
         "baseDirectory", "<>", "\"\<PeptideSimData/\>\"", 
          "<>", "\"\<SelectiveFac_\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"selectiveFactorList", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"assemblyData", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fileData", "=", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{"StringSplit", "[", 
                RowBox[{
                 RowBox[{"Import", "[", 
                  RowBox[{"simDir", "<>", "\"\</string_data_\>\"", "<>", 
                   RowBox[{"ToString", "[", "runID", "]"}], 
                   "<>", "\"\</seqList_\>\"", "<>", 
                   RowBox[{"ToString", "[", "runID", "]"}], 
                   "<>", "\"\<.txtOut\>\""}], "]"}], ",", "\"\<\\n\>\""}], 
                "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"First", "@", 
                 RowBox[{"StringSplit", "[", 
                  RowBox[{
                   RowBox[{"fileData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "\"\< \>\""}],
                   "]"}]}], ",", 
                RowBox[{"ToExpression", "@", 
                 RowBox[{"Last", "@", 
                  RowBox[{"StringSplit", "[", 
                   RowBox[{
                    RowBox[{"fileData", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "\"\< \>\""}],
                    "]"}]}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "fileData", "]"}]}], "}"}]}], "]"}]}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allData", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"assemblyData", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pts", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"StringLength", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", 
          "allData"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"maxLength", "=", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"Max", "[", 
            RowBox[{"Flatten", "[", "pts", "]"}], "]"}], "]"}], "+", "1"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"binCounts", "=", 
         RowBox[{"BinCounts", "[", 
          RowBox[{"pts", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxCount", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"Flatten", "[", "binCounts", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"logMax", "=", 
         RowBox[{"Log10", "[", "maxCount", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"majorCounts", "=", 
         RowBox[{"10", "^", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"Log10", "[", "maxCount", "]"}], "]"}]}], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"legendTicks", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Log10", "[", "#", "]"}], ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"#", ",", 
               RowBox[{"DigitBlock", "->", "3"}]}], "]"}]}], "}"}], "&"}], "/@",
           "majorCounts"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"colourFunction", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"z", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"z", "<=", "0"}], ",", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", 
               RowBox[{"Opacity", "[", "0", "]"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"ColorData", "[", "\"\<BlueGreenYellow\>\"", "]"}], "[", 
              RowBox[{"Rescale", "[", 
               RowBox[{
                RowBox[{"Log10", "[", "z", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "logMax"}], "}"}]}], "]"}], "]"}]}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"legend", "=", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<BlueGreenYellow\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "logMax"}], "}"}]}], "}"}], ",", 
           RowBox[{"Ticks", "->", "legendTicks"}], ",", 
           RowBox[{"LegendMarkerSize", "->", 
            RowBox[{"{", 
             RowBox[{"10", ",", "180"}], "}"}]}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"FontSize", "->", "16"}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plot", "=", 
         RowBox[{"DensityHistogram", "[", 
          RowBox[{"pts", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}]}], "}"}], 
           ",", "\"\<Count\>\"", ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"\"\<Selective Factor: \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"selectiveFactorList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ColorFunction", "->", "colourFunction"}], ",", 
           RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
           RowBox[{"ChartLegends", "->", 
            RowBox[{"Placed", "[", 
             RowBox[{"legend", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Scaled", "[", 
                 RowBox[{"{", 
                  RowBox[{"0.06", ",", "0.94"}], "}"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0.2", ",", "0.95"}], "}"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"AspectRatio", "->", "1"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<String Length\>\"", ",", "\"\<Assembly Index\>\""}],
              "}"}]}], ",", 
           RowBox[{"LabelStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"FontSize", "->", "18"}]}], "]"}]}], ",", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Darker", "@", "Red"}], ",", "Dashed", ",", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"maxLength", ",", "maxLength"}], "}"}]}], "}"}], 
               "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "maxLength"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "maxLength"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"simDir", "<>", "\"\</Distribution_SF_\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"selectiveFactorList", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], 
           "<>", "\"\<LogPlot.png\>\""}], ",", "plot", ",", 
          RowBox[{"ImageResolution", "->", "300"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"simDir", "<>", "\"\</Distribution_SF_\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"selectiveFactorList", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], 
           "<>", "\"\<LogPlot.svg\>\""}], ",", "plot"}], "]"}], ";", 
        "\[IndentingNewLine]", "plot"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Length", "[", "selectiveFactorList", "]"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
