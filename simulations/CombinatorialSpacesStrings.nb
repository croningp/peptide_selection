Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Rewriting", " ", "the", " ", "function", " ", "for", " ", "parallel", " ",
      "table"}], ",", " ", 
    RowBox[{
    "removing", " ", "the", " ", "monitor", " ", "function", " ", "as", " ", 
     "used", " ", "previously"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"generateAssemblyPossible", "[", 
    RowBox[{"nInitObjects_", ",", "nSteps_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"initObjects", ",", "obj1", ",", "obj2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"assemblyPool", ",", "assemblyStep"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"initObjects", "=", 
       RowBox[{
        RowBox[{"Alphabet", "[", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "nInitObjects"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"assemblyPool", "=", "initObjects"}], ";", 
      RowBox[{"assemblyStep", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"obj1", "=", 
          RowBox[{"RandomChoice", "[", "assemblyPool", "]"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{"Selecting", " ", "first", " ", "object", " ", "randomly"}],
           " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"obj2", "=", 
          RowBox[{"RandomChoice", "[", "assemblyPool", "]"}]}], ";", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Selecting", " ", "second", " ", "object", " ", "randomly"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"assemblyStep", "=", 
          RowBox[{"Union", "@", 
           RowBox[{"Append", "[", 
            RowBox[{"assemblyStep", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"obj1", "->", 
                RowBox[{"obj1", "<>", "obj2"}]}], ",", 
               RowBox[{"obj2", "->", 
                RowBox[{"obj1", "<>", "obj2"}]}]}], "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"assemblyPool", "=", 
          RowBox[{"Union", "@", 
           RowBox[{"Append", "[", 
            RowBox[{"assemblyPool", ",", 
             RowBox[{"obj1", "<>", "obj2"}]}], "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "nSteps"}], "}"}]}], "]"}], ";", " ", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"assemblyStep", ",", "assemblyPool"}], "}"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.963982096005427*^9, 3.963982098462569*^9}, {
