  3.997430701166317*^9}},ExpressionUUID->"233f6436-1162-4837-9354-\
d73fcfbdb59b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "function", " ", "takes", " ", "very", " ", "long", " ", 
    "time", " ", "to", " ", 
    RowBox[{"run", " ", ":", " ", 
     RowBox[{
      RowBox[{"Approx", " ", "24"}], "-", 
      RowBox[{"36", " ", "hours"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"runSimulation", "[", 
     RowBox[{"selectiveFactor_", ",", "baseDirectory_", ",", 
      RowBox[{"nRuns_", ":", "16"}], ",", 
      RowBox[{"nSteps_", ":", 
       RowBox[{"10", "^", "6"}]}], ",", 
      RowBox[{"initPop_", ":", 
       RowBox[{"10", "^", "6"}]}], ",", 
      RowBox[{"baseSeed_", ":", "123"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"simDir", ",", "dataSimOut"}], "}"}], ",", 
      RowBox[{
       RowBox[{"simDir", "=", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"baseDirectory", ",", 
           RowBox[{"\"\<SelectiveFac_\>\"", "<>", 
            RowBox[{"ToString", "[", "selectiveFactor", "]"}]}]}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"DirectoryQ", "[", "simDir", "]"}], ",", 
         RowBox[{"DeleteDirectory", "[", 
          RowBox[{"simDir", ",", 
           RowBox[{"DeleteContents", "->", "True"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"simDir", ",", 
         RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"simDir", ",", 
             RowBox[{"\"\<string_data_\>\"", "<>", 
              RowBox[{"ToString", "[", "i", "]"}]}]}], "}"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nRuns"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dataSimOut", "=", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "seqList", ",", "popList", ",", "endsList", ",", "boostMask", ",",
               "posActive", ",", "p", ",", "w", ",", "s", ",", "obj1", ",", 
              "obj2", ",", "i1", ",", "object", ",", "posA", ",", "posB", ",",
               "posN", ",", 
              RowBox[{"step", "=", "0"}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"SeedRandom", "[", 
              RowBox[{"baseSeed", "+", "runID"}], "]"}], ";", 
             RowBox[{"seqList", "=", 
              RowBox[{"{", 
               
               RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", 
                ",", "\"\<d\>\"", ",", "\"\<e\>\""}], "}"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"popList", "=", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"initPop", ",", "5"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{"step", "<", "nSteps"}], ",", 
               RowBox[{
                RowBox[{"endsList", "=", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"#", ",", "1"}], "]"}], ",", 
                    RowBox[{"StringTake", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], "}"}], "&"}], "/@", 
                   "seqList"}], ")"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"boostMask", "=", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"AnyTrue", "[", 
                    RowBox[{
                    RowBox[{"endsList", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "==", "\"\<b\>\""}], "&"}], ",", "1"}], 
                    "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "@", "endsList"}]}], "}"}]}], "]"}]}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"posActive", "=", 
                 RowBox[{"Pick", "[", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"Length", "@", "seqList"}], "]"}], ",", "popList",
                    ",", 
                   RowBox[{"_", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", ">", "0"}], "&"}], ")"}]}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"posActive", "===", 
                   RowBox[{"{", "}"}]}], ",", 
                  RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"p", "=", 
                 RowBox[{"popList", "[", 
                  RowBox[{"[", "posActive", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"w", "=", 
                 RowBox[{"p", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"#", "===", "True"}], ",", "selectiveFactor", ",",
                     "1"}], "]"}], "&"}], "/@", 
                    RowBox[{"boostMask", "[", 
                    RowBox[{"[", "posActive", "]"}], "]"}]}], ")"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"s", "=", 
                 RowBox[{"seqList", "[", 
                  RowBox[{"[", "posActive", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Total", "[", "w", "]"}], "==", "0"}], ",", 
                  RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"obj1", "=", 
                 RowBox[{"RandomChoice", "[", 
                  RowBox[{"w", "->", "s"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"i1", "=", 
                 RowBox[{"First", "@", 
                  RowBox[{"First", "@", 
                   RowBox[{"Position", "[", 
                    RowBox[{"s", ",", "obj1"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"p", "[", 
                  RowBox[{"[", "i1", "]"}], "]"}], "-=", "1"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"w", "[", 
                  RowBox[{"[", "i1", "]"}], "]"}], "=", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "i1", "]"}], "]"}], " ", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"boostMask", "[", 
                    RowBox[{"[", 
                    RowBox[{"posActive", "[", 
                    RowBox[{"[", "i1", "]"}], "]"}], "]"}], "]"}], "===", 
                    "True"}], ",", "selectiveFactor", ",", "1"}], "]"}]}]}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"w", "=", 
                 RowBox[{"Clip", "[", 
                  RowBox[{
                   RowBox[{"w", " ", 
                    RowBox[{"UnitStep", "[", "p", "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Total", "[", "w", "]"}], "==", "0"}], ",", 
                  RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"obj2", "=", 
                 RowBox[{"RandomChoice", "[", 
                  RowBox[{"w", "->", "s"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"posA", "=", 
                 RowBox[{"First", "@", 
                  RowBox[{"First", "@", 
                   RowBox[{"Position", "[", 
                    RowBox[{"seqList", ",", "obj1"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"posB", "=", 
                 RowBox[{"First", "@", 
                  RowBox[{"First", "@", 
                   RowBox[{"Position", "[", 
                    RowBox[{"seqList", ",", "obj2"}], "]"}]}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"object", "=", 
                 RowBox[{"StringJoin", "[", 
                  RowBox[{"{", 
                   RowBox[{"obj1", ",", "obj2"}], "}"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"popList", "[", 
                  RowBox[{"[", "posA", "]"}], "]"}], "--"}], ";", 
                RowBox[{
                 RowBox[{"popList", "[", 
                  RowBox[{"[", "posB", "]"}], "]"}], "--"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"MemberQ", "[", 
                   RowBox[{"seqList", ",", "object"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"posN", "=", 
                    RowBox[{"First", "@", 
                    RowBox[{"First", "@", 
                    RowBox[{"Position", "[", 
                    RowBox[{"seqList", ",", "object"}], "]"}]}]}]}], ";", 
                   RowBox[{
                    RowBox[{"popList", "[", 
                    RowBox[{"[", "posN", "]"}], "]"}], "++"}]}], ",", 
                  RowBox[{
                   RowBox[{"seqList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"seqList", ",", "object"}], "]"}]}], ";", 
                   RowBox[{"popList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"popList", ",", "1"}], "]"}]}]}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"step", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"seqList", ",", "popList"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"simDir", ",", 
              RowBox[{"\"\<string_data_\>\"", "<>", 
               RowBox[{"ToString", "[", "runID", "]"}]}], ",", 
              RowBox[{"\"\<seqList_\>\"", "<>", 
               RowBox[{"ToString", "[", "runID", "]"}], 
               "<>", "\"\<.txt\>\""}]}], "}"}], "]"}], ",", 
           RowBox[{"dataSimOut", "[", 
            RowBox[{"[", 
             RowBox[{"runID", ",", "1"}], "]"}], "]"}], 
           ",", "\"\<Lines\>\""}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "dataSimOut"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.992335800946376*^9, 3.99233581208615*^9}, 
   3.992335844695098*^9, {3.992339794366788*^9, 3.992339794629764*^9}, 
   3.992360779331335*^9, {3.992360951132308*^9, 3.992360951448181*^9}, 
   3.992361446859125*^9, {3.992368283596489*^9, 3.9923682858788223`*^9}, {
   3.9923692939541197`*^9, 3.992369294578115*^9}, {3.9925052886128263`*^9, 
   3.992505316177328*^9}},ExpressionUUID->"e9e13e3b-fd5a-4a6a-96d1-\
e2e8f912f6f1"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"runSimulation", "[", 
    RowBox[{"sf", ",", "baseDirectory"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"sf", ",", 
     RowBox[{"{", 
      RowBox[{"100", ",", "75", ",", "50", ",", "25", ",", "10", ",", "1"}], 
      "}"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.991978122463998*^9, 3.991978125436097*^9}, {
  3.9922556622344303`*^9, 3.9922556721968813`*^9}, {3.992335823621031*^9, 
  3.992335835785783*^9}, {3.992335926842189*^9, 3.992335948055346*^9}, {
  3.992339802734963*^9, 3.992339802918603*^9}, {3.9923682544985247`*^9, 
  3.992368276571415*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"0304a830-984d-4e60-a000-078702994f92"],

Cell["TO PLOT THE DATA, SIMULATED DATA ALREADY PRESENT.", "Text",
 CellChangeTimes->{{3.9974307053368692`*^9, 
  3.9974307286681147`*^9}},ExpressionUUID->"3151f862-a48d-4362-8fe6-\
37d10f3c1494"],

Cell[BoxData[
 RowBox[{
  RowBox[{"selectiveFactorList", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "10", ",", "25", ",", "50", ",", "75", ",", "100"}], 
    "}"}]}], ";", 
  RowBox[{"nRuns", "=", "16"}], ";"}]], "Input",
 CellChangeTimes->{{3.992164596486085*^9, 3.992164619133161*^9}, {
  3.9922556822584543`*^9, 3.992255682649078*^9}, {3.992436000085034*^9, 
  3.992436005881312*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"9fc831ea-c886-4d5b-9c5a-a9ff8819a099"],

Cell[BoxData[
 RowBox[{
  RowBox[{"outputPlots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "simDir", ",", "assemblyData", ",", "data", ",", "maxLength", ",", 
         "plot"}], "}"}], ",", 
       RowBox[{
        RowBox[{"simDir", "=", 
         RowBox[{
         "baseDirectory", "<>", "\"\<PeptideSimData/\>\"", 
          "<>", "\"\<SelectiveFac_\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"selectiveFactorList", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"assemblyData", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fileData", "=", 
             RowBox[{"Partition", "[", 
              RowBox[{
               RowBox[{"StringSplit", "[", 
                RowBox[{
                 RowBox[{"Import", "[", 
                  RowBox[{"simDir", "<>", "\"\</string_data_\>\"", "<>", 
                   RowBox[{"ToString", "[", "runID", "]"}], 
                   "<>", "\"\</seqList_\>\"", "<>", 
                   RowBox[{"ToString", "[", "runID", "]"}], 
                   "<>", "\"\<.txtOut\>\""}], "]"}], ",", "\"\<\\n\>\""}], 
                "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"data", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"First", "@", 
                  RowBox[{"StringSplit", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"fileData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< \>\""}], 
                   "]"}]}], ",", 
                 RowBox[{"ToExpression", "@", 
                  RowBox[{"Last", "@", 
                   RowBox[{"StringSplit", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"fileData", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< \>\""}], 
                    "]"}]}]}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "@", "fileData"}]}], "}"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"runID", ",", "nRuns"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxLength", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"StringLength", "/@", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plot", "=", 
         RowBox[{"DensityHistogram", "[", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"StringLength", "/@", 
                RowBox[{
                 RowBox[{"assemblyData", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"assemblyData", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "maxLength", ",", "1"}], "}"}]}], "}"}], ",", 
           
           RowBox[{"PlotLabel", "->", 
            RowBox[{"\"\<Selective Factor: \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"selectiveFactorList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ChartLegends", "->", 
            RowBox[{"Placed", "[", 
             RowBox[{
              RowBox[{"BarLegend", "[", 
               RowBox[{"Automatic", ",", 
                RowBox[{"LegendMarkerSize", "->", 
                 RowBox[{"{", 
                  RowBox[{"10", ",", "180"}], "}"}]}], ",", 
                RowBox[{"LabelStyle", "->", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"Black", ",", 
                   RowBox[{"FontSize", "->", "16"}]}], "]"}]}]}], "]"}], ",", 
              
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Scaled", "[", 
                 RowBox[{"{", 
                  RowBox[{"0.05", ",", "0.95"}], "}"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0.2", ",", "0.95"}], "}"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"AspectRatio", "->", "1"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
           RowBox[{"LabelStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Black", ",", 
              RowBox[{"Directive", "[", 
               RowBox[{"Black", ",", 
                RowBox[{"FontColor", "\[Rule]", "Black"}], ",", 
                RowBox[{"FontSize", "\[Rule]", "18"}]}], "]"}]}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<String Length\>\"", ",", "\"\<Assembly Index\>\""}],
              "}"}]}], ",", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Darker", "@", "Red"}], ",", "Dashed", ",", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"maxLength", ",", "maxLength"}], "}"}]}], "}"}], 
               "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "maxLength"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "maxLength"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"ImageSize", "->", "300"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"simDir", "<>", "\"\<Distribution_SF_\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"selectiveFactorList", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], "<>", "\"\<.png\>\""}], ",",
           "plot", ",", 
          RowBox[{"ImageResolution", "->", "300"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"simDir", "<>", "\"\<Distribution_SF_\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"selectiveFactorList", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], "<>", "\"\<.svg\>\""}], ",",
           "plot"}], "]"}], ";", "plot"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Length", "@", "selectiveFactorList"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.993101808537232*^9, 3.9931018347555323`*^9}, {
   3.993101870614799*^9, 3.9931018964786787`*^9}, {3.993101927579938*^9, 
   3.9931019348803387`*^9}, {3.9931053911865473`*^9, 3.993105391438261*^9}, {
   3.993105423719166*^9, 3.993105519688056*^9}, 3.993105553180079*^9, {
   3.993108481202417*^9, 3.993108488341433*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"67793b3a-411f-4fd0-880a-b4210e28c09e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"Partition", "[", 
    RowBox[{"outputPlots", ",", "3"}], "]"}], ",", 
   RowBox[{"ImageSize", "->", "1000"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99243647984298*^9, 3.992436487866341*^9}, {
